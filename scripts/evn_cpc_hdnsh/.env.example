# Sao chép thành file .env (cùng thư mục script) rồi điền thông tin thật. KHÔNG commit file .env.
CPC_BASE_URL=https://cskh.cpc.vn
CPC_USERNAME=USERNAME
# Để trống CPC_PASSWORD nếu lưu mật khẩu trong Windows Credential Manager:
#   python -c "import keyring; keyring.set_password('cskh.cpc.vn', 'USERNAME', input('Mat khau: '))"
# hoặc để trống để script hỏi mật khẩu khi chạy.
CPC_PASSWORD=PASSWORD
# (tùy chọn) đường dẫn Chrome/Chromium nếu không dùng Microsoft Edge
# CPC_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
